# Resend API key (https://resend.com/api-keys). Set it in .env.local locally and in
# Vercel → Project → Settings → Environment Variables for production. Never commit it.
RESEND_API_KEY=

# Where contact enquiries are delivered.
CONTACT_TO_EMAIL=nusta.aashu@gmail.com

# Sender. "onboarding@resend.dev" works without a verified domain, but Resend then only
# delivers to the email address that owns the Resend account. After verifying your own
# domain in Resend, change this to e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
